NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/mobile_installment?schema=public
REDIS_URL=redis://localhost:6379
NATIONAL_ID_ENCRYPTION_KEY=replace-with-at-least-32-character-secret
KYC_STORAGE_ROOT=./storage/kyc
OCR_PROVIDER=sandbox
PAYMENT_WEBHOOK_SECRET=replace-with-at-least-32-character-webhook-secret
PAYMENT_PROVIDER=sandbox
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CUSTOMER_OTP_SANDBOX_CODE=123456
MERCHANT_WEB_ORIGIN=http://localhost:5173
DPC_COMPONENT_NAME=com.mip.dpc/com.mip.dpc.MipDeviceAdminReceiver
DPC_DOWNLOAD_URL=
DPC_PACKAGE_CHECKSUM=
# Must be https://…/api/v1/devices/enroll/check-in (no secrets in URL). Lab: https://<LAN-IP>:3443/api/v1/devices/enroll/check-in
DPC_ENROLLMENT_ENDPOINT=
# Lab HTTPS (optional). Generate with scripts/generate-lab-https-certs.sh — never commit private keys.
# TLS_CERT_PATH=./lab-certs/server.crt
# TLS_KEY_PATH=./lab-certs/server.key
# HTTPS_PORT=3443
# Lab overdue evaluate cron (Phase 4c). Unset/empty = disabled. Example hourly: 0 * * * *
# OVERDUE_EVALUATE_CRON=
# Per-tenant MDM credentials live in a secret manager. Store the reference id only — never APNs/MDM private keys in git.
# DEVICE_MDM_SECRET_REF=
# Optional; if unset, NATIONAL_ID_ENCRYPTION_KEY encrypts LINE channel secrets at rest (R3-P0 sandbox).
# LINE_CREDENTIALS_ENCRYPTION_KEY=

