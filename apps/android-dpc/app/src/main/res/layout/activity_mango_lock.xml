<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mip_teal"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:text="@string/lock_brand"
            android:textColor="@color/mip_sand"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/lock_title_th"
            android:textColor="@color/mip_sand"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0.72"
            android:text="@string/lock_title_en"
            android:textColor="@color/mip_sand"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/lock_body_th"
            android:textColor="@color/mip_sand"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0.65"
            android:text="@string/lock_body_en"
            android:textColor="@color/mip_sand"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/lock_reason_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:alpha="0.8"
            android:textColor="@color/mip_sand"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/mip_teal_deep"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.65"
            android:letterSpacing="0.06"
            android:text="@string/lock_status_heading"
            android:textColor="@color/mip_sand"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/lock_status_th"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/mip_sand"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lock_status_en"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.7"
            android:textColor="@color/mip_sand"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/lock_amount_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="14dp"
                android:alpha="0.2"
                android:background="@color/mip_sand" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.65"
                android:text="@string/lock_amount_heading"
                android:textColor="@color/mip_sand"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/lock_amount_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/mip_sand"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lock_due_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:alpha="0.7"
                android:textColor="@color/mip_sand"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/lock_contract_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="14dp"
                android:alpha="0.2"
                android:background="@color/mip_sand" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.65"
                android:text="@string/lock_contract_heading"
                android:textColor="@color/mip_sand"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/lock_contract_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/mip_sand"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:alpha="0.7"
                android:text="@string/lock_contact_merchant"
                android:textColor="@color/mip_sand"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/lock_emergency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:backgroundTint="@color/mip_sand"
            android:text="@string/lock_emergency"
            android:textAllCaps="false"
            android:textColor="@color/mip_teal"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
