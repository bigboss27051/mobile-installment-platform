generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum PlatformRole {
  SUPER_ADMIN
  MERCHANT_OWNER
  MERCHANT_STAFF
}

enum CatalogStatus {
  ACTIVE
  INACTIVE
}

enum ImeiStatus {
  AVAILABLE
  RESERVED
  SOLD
  TRANSFERRED_OUT
}

enum StockMovementType {
  RECEIVE
  TRANSFER
  RESERVE
  RELEASE
  SELL
  ADJUST
}

enum CustomerStatus {
  ACTIVE
  DISABLED
}

enum KycCaseStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
  NEEDS_RESUBMIT
}

enum KycDocumentType {
  ID_FRONT
  ID_BACK
  SELFIE
  OTHER
}

enum ConsentType {
  PDPA_PROCESSING
  MARKETING
  LINE_MESSAGING
}

enum LineChannelStatus {
  DISCONNECTED
  CONNECTED
  ERROR
}

enum LineLinkStatus {
  ACTIVE
  UNLINKED
}

enum LineDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum LineNotifyType {
  PAYMENT_CONFIRMATION
  PAYMENT_REMINDER
  CONTRACT_INFO
}

enum KycReviewDecision {
  APPROVE
  REJECT
  REQUEST_RESUBMIT
}

enum InterestMethod {
  FLAT
  REDUCING
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

enum ScorecardBand {
  LOW
  MEDIUM
  HIGH
}

enum ApplicationDecision {
  APPROVE
  REJECT
}

enum ContractStatus {
  DRAFT
  ACTIVE
  CANCELLED
  CLOSED
}

enum ScheduleItemStatus {
  PENDING
  PARTIAL
  PAID
}

enum PaymentIntentStatus {
  CREATED
  AWAITING_PROVIDER
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
}

enum PaymentTransactionStatus {
  SUCCEEDED
  FAILED
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum LedgerDomain {
  INSTALLMENT
  SAAS
}

enum DevicePlatform {
  ANDROID
  IOS
}

enum EnrollmentSessionStatus {
  NOT_STARTED
  WAITING_FOR_DEVICE
  QR_GENERATED
  PROVISIONING
  ENROLLING
  VERIFYING
  ACTIVATING
  COMPLETED
  FAILED
  EXPIRED
  CANCELLED
  RECOVERY_REQUIRED
}

enum DeviceLifecycleStatus {
  PENDING_ENROLL
  ENROLLED
  ACTIVE
  UNENROLLED
}

enum DeviceBindingStatus {
  ACTIVE
  UNBOUND
  REPLACED
}

enum DeviceAuditAction {
  ACTIVATE
  BIND
  UNBIND
  CHECK_IN
  COMMAND
  RECOVERY
  LOCATION_READ
  POLICY_SETTINGS
  LOCK_APPROVAL
}

enum DeviceLockApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum DeviceLocationSource {
  NETWORK
  GPS
  FUSED
  UNKNOWN
}

enum DeviceRecoveryType {
  REENROLL
  REPLACE
  UNENROLL
  RELEASE
  CONTRACT_CLOSE
}

enum DeviceRecoveryStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum DeviceCommandType {
  START_LOCK_TASK
  STOP_LOCK_TASK
  START_PACKAGE_SUSPEND
  STOP_PACKAGE_SUSPEND
}

enum DeviceCommandStatus {
  QUEUED
  SENT
  ACKED_SUCCESS
  ACKED_FAILED
  EXPIRED
  UNSUPPORTED
}

enum DesiredPresentation {
  NONE
  REMINDER
  RESTRICT
  LOCK
}

enum PlatformEnforcementState {
  NONE
  PACKAGES_SUSPENDED
  LOCK_TASK
  SINGLE_APP_MODE
  UNSUPPORTED
  PENDING
}

model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  slug      String       @unique
  status    TenantStatus @default(PENDING)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  branches  Branch[]
  users     User[]
  userBranchAssignments UserBranchAssignment[]
  products  Product[]
  variants  ProductVariant[]
  imeiUnits ImeiUnit[]
  stockMovements StockMovement[]
  customers       Customer[]
  kycCases        KycCase[]
  kycDocuments    KycDocument[]
  consents        Consent[]
  kycReviewActions KycReviewAction[]
  installmentPlans InstallmentPlan[]
  applications     Application[]
  scorecardResults ScorecardResult[]
  approvalActions  ApprovalAction[]
  contracts        Contract[]
  contractVersions ContractVersion[]
  paymentScheduleItems PaymentScheduleItem[]
  paymentIntents      PaymentIntent[]
  paymentTransactions PaymentTransaction[]
  allocations         Allocation[]
  ledgerEntries       LedgerEntry[]
  customerOtpChallenges CustomerOtpChallenge[]
  deviceEnrollmentSessions DeviceEnrollmentSession[]
  devices                 Device[]
  deviceActivations       DeviceActivation[]
  deviceContractBindings  DeviceContractBinding[]
  deviceAuditEvents       DeviceAuditEvent[]
  deviceCommands          DeviceCommand[]
  devicePolicyEvaluationRuns DevicePolicyEvaluationRun[]
  devicePolicyStates      DevicePolicyState[]
  deviceRecoveryRequests  DeviceRecoveryRequest[]
  deviceLocationSamples   DeviceLocationSample[]
  lineChannelConfig       LineChannelConfig?
  lineCustomerLinks       LineCustomerLink[]
  lineLinkingTokens       LineLinkingToken[]
  lineWebhookEvents       LineWebhookEvent[]
  lineNotificationTemplates LineNotificationTemplate[]
  lineNotificationDeliveries LineNotificationDelivery[]
  lineAuditEvents         LineAuditEvent[]
  devicePolicySettings    TenantDevicePolicySettings?
  deviceLockApprovals     DeviceLockApproval[]

  @@map("tenants")
}

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  imeiUnits ImeiUnit[]
  userAssignments UserBranchAssignment[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("branches")
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String?        @map("tenant_id") @db.Uuid
  email         String         @unique
  passwordHash  String         @map("password_hash")
  fullName      String         @map("full_name")
  role          PlatformRole   @default(MERCHANT_STAFF)
  status        UserStatus     @default(ACTIVE)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  tenant        Tenant?        @relation(fields: [tenantId], references: [id])
  refreshTokens RefreshToken[]
  stockMovements StockMovement[]
  kycDocumentsUploaded KycDocument[]
  kycReviewActions     KycReviewAction[]
  approvalActions      ApprovalAction[]
  createdPaymentIntents PaymentIntent[]
  enrollmentSessionsCreated DeviceEnrollmentSession[]
  deviceActivations         DeviceActivation[]
  deviceContractBindings    DeviceContractBinding[]
  deviceAuditEvents         DeviceAuditEvent[]
  deviceCommands            DeviceCommand[]
  devicePolicyEvaluationRuns DevicePolicyEvaluationRun[]
  deviceRecoveryRequests    DeviceRecoveryRequest[]
  resolvedLockApprovals     DeviceLockApproval[] @relation("LockApprovalResolver")
  branchAssignments UserBranchAssignment[]

  @@index([tenantId])
  @@map("users")
}

/** STAFF branch scope. OWNER/SUPER_ADMIN ignore rows (all tenant branches). */
model UserBranchAssignment {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@index([tenantId, userId])
  @@index([tenantId, branchId])
  @@map("user_branch_assignments")
}

model Customer {
  id                  String         @id @default(uuid()) @db.Uuid
  tenantId            String         @map("tenant_id") @db.Uuid
  fullName            String         @map("full_name")
  phone               String
  nationalIdEncrypted String         @map("national_id_encrypted")
  nationalIdHash      String         @map("national_id_hash")
  nationalIdLast4     String         @map("national_id_last4")
  status              CustomerStatus @default(ACTIVE)
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")
  tenant              Tenant         @relation(fields: [tenantId], references: [id])
  kycCases            KycCase[]
  consents            Consent[]
  applications        Application[]
  contracts           Contract[]
  createdPaymentIntents PaymentIntent[]
  otpChallenges         CustomerOtpChallenge[]
  deviceActivations     DeviceActivation[]
  lineCustomerLinks     LineCustomerLink[]
  lineLinkingTokens     LineLinkingToken[]
  lineNotificationDeliveries LineNotificationDelivery[]

  @@unique([tenantId, phone])
  @@index([tenantId, nationalIdHash])
  @@map("customers")
}

model CustomerOtpChallenge {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  customerId  String    @map("customer_id") @db.Uuid
  phone       String
  codeHash    String    @map("code_hash")
  expiresAt   DateTime  @map("expires_at")
  consumedAt  DateTime? @map("consumed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  customer    Customer  @relation(fields: [customerId], references: [id])

  @@index([tenantId, phone, createdAt])
  @@map("customer_otp_challenges")
}

model KycCase {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  customerId     String        @map("customer_id") @db.Uuid
  status         KycCaseStatus @default(DRAFT)
  ocrProvider    String?       @map("ocr_provider")
  ocrSummaryJson Json?         @map("ocr_summary_json")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  customer       Customer      @relation(fields: [customerId], references: [id])
  documents      KycDocument[]
  reviewActions  KycReviewAction[]

  @@index([tenantId, customerId])
  @@index([tenantId, status])
  @@map("kyc_cases")
}

model KycDocument {
  id               String          @id @default(uuid()) @db.Uuid
  tenantId         String          @map("tenant_id") @db.Uuid
  kycCaseId        String          @map("kyc_case_id") @db.Uuid
  type             KycDocumentType
  storageKey       String          @map("storage_key")
  mimeType         String          @map("mime_type")
  checksum         String?
  uploadedByUserId String          @map("uploaded_by_user_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at")
  tenant           Tenant          @relation(fields: [tenantId], references: [id])
  kycCase          KycCase         @relation(fields: [kycCaseId], references: [id])
  uploadedBy       User            @relation(fields: [uploadedByUserId], references: [id])

  @@index([tenantId, kycCaseId])
  @@map("kyc_documents")
}

model Consent {
  id         String      @id @default(uuid()) @db.Uuid
  tenantId   String      @map("tenant_id") @db.Uuid
  customerId String      @map("customer_id") @db.Uuid
  type       ConsentType
  version    String
  grantedAt  DateTime    @map("granted_at")
  revokedAt  DateTime?   @map("revoked_at")
  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  customer   Customer    @relation(fields: [customerId], references: [id])

  @@index([tenantId, customerId])
  @@map("consents")
}

model KycReviewAction {
  id         String            @id @default(uuid()) @db.Uuid
  tenantId   String            @map("tenant_id") @db.Uuid
  kycCaseId  String            @map("kyc_case_id") @db.Uuid
  actorUserId String           @map("actor_user_id") @db.Uuid
  decision   KycReviewDecision
  reason     String?
  createdAt  DateTime          @default(now()) @map("created_at")
  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  kycCase    KycCase           @relation(fields: [kycCaseId], references: [id])
  actor      User              @relation(fields: [actorUserId], references: [id])

  @@index([tenantId, kycCaseId])
  @@map("kyc_review_actions")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

model Product {
  id        String        @id @default(uuid()) @db.Uuid
  tenantId  String        @map("tenant_id") @db.Uuid
  name      String
  brand     String
  status    CatalogStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  variants  ProductVariant[]

  @@index([tenantId])
  @@map("products")
}

model ProductVariant {
  id        String        @id @default(uuid()) @db.Uuid
  tenantId  String        @map("tenant_id") @db.Uuid
  productId String        @map("product_id") @db.Uuid
  sku       String
  color     String
  storage   String
  price     Decimal       @db.Decimal(18, 2)
  currency  String        @default("THB") @db.Char(3)
  status    CatalogStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  product   Product       @relation(fields: [productId], references: [id])
  imeiUnits ImeiUnit[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([productId])
  @@map("product_variants")
}

model ImeiUnit {
  id        String         @id @default(uuid()) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  branchId  String         @map("branch_id") @db.Uuid
  variantId String         @map("variant_id") @db.Uuid
  imei      String?
  serial    String?
  status    ImeiStatus     @default(AVAILABLE)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  branch    Branch         @relation(fields: [branchId], references: [id])
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  movements StockMovement[]
  applications Application[]
  contracts    Contract[]
  devices      Device[]
  deviceContractBindings DeviceContractBinding[]

  @@unique([tenantId, imei])
  @@unique([tenantId, serial])
  @@index([tenantId, branchId])
  @@index([tenantId, status])
  @@map("imei_units")
}

model StockMovement {
  id           String            @id @default(uuid()) @db.Uuid
  tenantId     String            @map("tenant_id") @db.Uuid
  imeiUnitId   String            @map("imei_unit_id") @db.Uuid
  type         StockMovementType
  fromBranchId String?           @map("from_branch_id") @db.Uuid
  toBranchId   String?           @map("to_branch_id") @db.Uuid
  actorUserId  String            @map("actor_user_id") @db.Uuid
  reason       String?
  createdAt    DateTime          @default(now()) @map("created_at")
  tenant       Tenant            @relation(fields: [tenantId], references: [id])
  imeiUnit     ImeiUnit          @relation(fields: [imeiUnitId], references: [id])
  actor        User              @relation(fields: [actorUserId], references: [id])

  @@index([tenantId, imeiUnitId])
  @@index([tenantId, createdAt])
  @@map("stock_movements")
}

model InstallmentPlan {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  code           String
  name           String
  interestMethod InterestMethod @map("interest_method")
  annualRate     Decimal        @map("annual_rate") @db.Decimal(18, 2)
  termMonths     Int            @map("term_months")
  feesJson       Json?          @map("fees_json")
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  applications   Application[]

  @@unique([tenantId, code])
  @@index([tenantId, active])
  @@map("installment_plans")
}

model Application {
  id              String            @id @default(uuid()) @db.Uuid
  tenantId        String            @map("tenant_id") @db.Uuid
  customerId      String            @map("customer_id") @db.Uuid
  imeiUnitId      String            @map("imei_unit_id") @db.Uuid
  planId          String            @map("plan_id") @db.Uuid
  principal       Decimal           @db.Decimal(18, 2)
  downPayment     Decimal           @map("down_payment") @db.Decimal(18, 2)
  termMonths      Int               @map("term_months")
  interestMethod  InterestMethod    @map("interest_method")
  annualRate      Decimal           @map("annual_rate") @db.Decimal(18, 2)
  status          ApplicationStatus @default(DRAFT)
  submittedAt     DateTime?         @map("submitted_at")
  decidedAt       DateTime?         @map("decided_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  tenant          Tenant            @relation(fields: [tenantId], references: [id])
  customer        Customer          @relation(fields: [customerId], references: [id])
  imeiUnit        ImeiUnit          @relation(fields: [imeiUnitId], references: [id])
  plan            InstallmentPlan   @relation(fields: [planId], references: [id])
  scorecard       ScorecardResult?
  approvalActions ApprovalAction[]
  contracts       Contract[]

  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, imeiUnitId])
  @@map("applications")
}

model ScorecardResult {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  applicationId String        @unique @map("application_id") @db.Uuid
  score         Int
  band          ScorecardBand
  reasonsJson   Json          @map("reasons_json")
  version       String
  createdAt     DateTime      @default(now()) @map("created_at")
  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  application   Application   @relation(fields: [applicationId], references: [id])

  @@index([tenantId])
  @@map("scorecard_results")
}

model ApprovalAction {
  id            String              @id @default(uuid()) @db.Uuid
  tenantId      String              @map("tenant_id") @db.Uuid
  applicationId String              @map("application_id") @db.Uuid
  actorUserId   String              @map("actor_user_id") @db.Uuid
  decision      ApplicationDecision
  reason        String?
  createdAt     DateTime            @default(now()) @map("created_at")
  tenant        Tenant              @relation(fields: [tenantId], references: [id])
  application   Application         @relation(fields: [applicationId], references: [id])
  actor         User                @relation(fields: [actorUserId], references: [id])

  @@index([tenantId, applicationId])
  @@map("approval_actions")
}

model Contract {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  applicationId  String         @map("application_id") @db.Uuid
  customerId     String         @map("customer_id") @db.Uuid
  imeiUnitId     String         @map("imei_unit_id") @db.Uuid
  status         ContractStatus @default(DRAFT)
  principal      Decimal        @db.Decimal(18, 2)
  downPayment    Decimal        @map("down_payment") @db.Decimal(18, 2)
  financedAmount Decimal        @map("financed_amount") @db.Decimal(18, 2)
  termMonths     Int            @map("term_months")
  interestMethod InterestMethod @map("interest_method")
  annualRate     Decimal        @map("annual_rate") @db.Decimal(18, 2)
  currency       String         @default("THB") @db.Char(3)
  activatedAt    DateTime?      @map("activated_at")
  cancelledAt    DateTime?      @map("cancelled_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  application    Application    @relation(fields: [applicationId], references: [id])
  customer       Customer       @relation(fields: [customerId], references: [id])
  imeiUnit       ImeiUnit       @relation(fields: [imeiUnitId], references: [id])
  versions       ContractVersion[]
  scheduleItems  PaymentScheduleItem[]
  paymentIntents PaymentIntent[]
  enrollmentSessions DeviceEnrollmentSession[]
  deviceActivations DeviceActivation[]
  deviceContractBindings DeviceContractBinding[]

  @@index([tenantId, status])
  @@index([tenantId, applicationId])
  @@map("contracts")
}

model ContractVersion {
  id            String     @id @default(uuid()) @db.Uuid
  tenantId      String     @map("tenant_id") @db.Uuid
  contractId    String     @map("contract_id") @db.Uuid
  version       Int
  termsJson     Json       @map("terms_json")
  scheduleHash  String     @map("schedule_hash")
  createdAt     DateTime   @default(now()) @map("created_at")
  tenant        Tenant     @relation(fields: [tenantId], references: [id])
  contract      Contract   @relation(fields: [contractId], references: [id])
  scheduleItems PaymentScheduleItem[]

  @@unique([contractId, version])
  @@index([tenantId])
  @@map("contract_versions")
}

model PaymentScheduleItem {
  id                String             @id @default(uuid()) @db.Uuid
  tenantId          String             @map("tenant_id") @db.Uuid
  contractId        String             @map("contract_id") @db.Uuid
  contractVersionId String             @map("contract_version_id") @db.Uuid
  seq               Int
  dueDate           DateTime           @map("due_date") @db.Date
  principalDue      Decimal            @map("principal_due") @db.Decimal(18, 2)
  interestDue       Decimal            @map("interest_due") @db.Decimal(18, 2)
  feesDue           Decimal            @map("fees_due") @db.Decimal(18, 2)
  totalDue          Decimal            @map("total_due") @db.Decimal(18, 2)
  amountPaid        Decimal            @default(0) @map("amount_paid") @db.Decimal(18, 2)
  status            ScheduleItemStatus @default(PENDING)
  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  contract          Contract           @relation(fields: [contractId], references: [id])
  contractVersion   ContractVersion    @relation(fields: [contractVersionId], references: [id])
  allocations       Allocation[]

  @@unique([contractVersionId, seq])
  @@index([tenantId, contractId])
  @@map("payment_schedule_items")
}

model PaymentIntent {
  id              String              @id @default(uuid()) @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  contractId      String              @map("contract_id") @db.Uuid
  amount          Decimal             @db.Decimal(18, 2)
  currency        String              @default("THB") @db.Char(3)
  idempotencyKey  String              @map("idempotency_key")
  status          PaymentIntentStatus @default(CREATED)
  provider        String
  providerRef     String?             @map("provider_ref")
  qrPayloadJson        Json?               @map("qr_payload_json")
  createdByUserId      String?             @map("created_by_user_id") @db.Uuid
  createdByCustomerId  String?             @map("created_by_customer_id") @db.Uuid
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  tenant               Tenant              @relation(fields: [tenantId], references: [id])
  contract             Contract            @relation(fields: [contractId], references: [id])
  createdBy            User?               @relation(fields: [createdByUserId], references: [id])
  createdByCustomer    Customer?           @relation(fields: [createdByCustomerId], references: [id])
  transaction          PaymentTransaction?

