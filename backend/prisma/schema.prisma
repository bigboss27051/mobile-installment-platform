generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum PlatformRole {
  SUPER_ADMIN
  MERCHANT_OWNER
  MERCHANT_STAFF
}

enum CatalogStatus {
  ACTIVE
  INACTIVE
}

enum ImeiStatus {
  AVAILABLE
  RESERVED
  SOLD
  TRANSFERRED_OUT
}

enum StockMovementType {
  RECEIVE
  TRANSFER
  RESERVE
  RELEASE
  SELL
  ADJUST
}

enum CustomerStatus {
  ACTIVE
  DISABLED
}

enum KycCaseStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
  NEEDS_RESUBMIT
}

enum KycDocumentType {
  ID_FRONT
  ID_BACK
  SELFIE
  OTHER
}

enum ConsentType {
  PDPA_PROCESSING
  MARKETING
}

enum KycReviewDecision {
  APPROVE
  REJECT
  REQUEST_RESUBMIT
}

enum InterestMethod {
  FLAT
  REDUCING
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

enum ScorecardBand {
  LOW
  MEDIUM
  HIGH
}

enum ApplicationDecision {
  APPROVE
  REJECT
}

enum ContractStatus {
  DRAFT
  ACTIVE
  CANCELLED
  CLOSED
}

enum ScheduleItemStatus {
  PENDING
  PARTIAL
  PAID
}

enum PaymentIntentStatus {
  CREATED
  AWAITING_PROVIDER
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
}

enum PaymentTransactionStatus {
  SUCCEEDED
  FAILED
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum LedgerDomain {
  INSTALLMENT
  SAAS
}

enum DevicePlatform {
  ANDROID
  IOS
}

enum EnrollmentSessionStatus {
  NOT_STARTED
  WAITING_FOR_DEVICE
  QR_GENERATED
  PROVISIONING
  ENROLLING
  VERIFYING
  ACTIVATING
  COMPLETED
  FAILED
  EXPIRED
  CANCELLED
  RECOVERY_REQUIRED
}

enum DeviceLifecycleStatus {
  PENDING_ENROLL
  ENROLLED
  ACTIVE
  UNENROLLED
}

enum DeviceBindingStatus {
  ACTIVE
  UNBOUND
  REPLACED
}

enum DeviceAuditAction {
  ACTIVATE
  BIND
  UNBIND
}

model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  slug      String       @unique
  status    TenantStatus @default(PENDING)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  branches  Branch[]
  users     User[]
  products  Product[]
  variants  ProductVariant[]
  imeiUnits ImeiUnit[]
  stockMovements StockMovement[]
  customers       Customer[]
  kycCases        KycCase[]
  kycDocuments    KycDocument[]
  consents        Consent[]
  kycReviewActions KycReviewAction[]
  installmentPlans InstallmentPlan[]
  applications     Application[]
  scorecardResults ScorecardResult[]
  approvalActions  ApprovalAction[]
  contracts        Contract[]
  contractVersions ContractVersion[]
  paymentScheduleItems PaymentScheduleItem[]
  paymentIntents      PaymentIntent[]
  paymentTransactions PaymentTransaction[]
  allocations         Allocation[]
  ledgerEntries       LedgerEntry[]
  customerOtpChallenges CustomerOtpChallenge[]
  deviceEnrollmentSessions DeviceEnrollmentSession[]
  devices                 Device[]
  deviceActivations       DeviceActivation[]
  deviceContractBindings  DeviceContractBinding[]
  deviceAuditEvents       DeviceAuditEvent[]

  @@map("tenants")
}

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  imeiUnits ImeiUnit[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("branches")
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String?        @map("tenant_id") @db.Uuid
  email         String         @unique
  passwordHash  String         @map("password_hash")
  fullName      String         @map("full_name")
  role          PlatformRole   @default(MERCHANT_STAFF)
  status        UserStatus     @default(ACTIVE)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  tenant        Tenant?        @relation(fields: [tenantId], references: [id])
  refreshTokens RefreshToken[]
  stockMovements StockMovement[]
  kycDocumentsUploaded KycDocument[]
  kycReviewActions     KycReviewAction[]
  approvalActions      ApprovalAction[]
  createdPaymentIntents PaymentIntent[]
  enrollmentSessionsCreated DeviceEnrollmentSession[]
  deviceActivations         DeviceActivation[]
  deviceContractBindings    DeviceContractBinding[]
  deviceAuditEvents         DeviceAuditEvent[]

  @@index([tenantId])
  @@map("users")
}

model Customer {
  id                  String         @id @default(uuid()) @db.Uuid
  tenantId            String         @map("tenant_id") @db.Uuid
  fullName            String         @map("full_name")
  phone               String
  nationalIdEncrypted String         @map("national_id_encrypted")
  nationalIdHash      String         @map("national_id_hash")
  nationalIdLast4     String         @map("national_id_last4")
  status              CustomerStatus @default(ACTIVE)
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")
  tenant              Tenant         @relation(fields: [tenantId], references: [id])
  kycCases            KycCase[]
  consents            Consent[]
  applications        Application[]
  contracts           Contract[]
  createdPaymentIntents PaymentIntent[]
  otpChallenges         CustomerOtpChallenge[]
  deviceActivations     DeviceActivation[]

  @@unique([tenantId, phone])
  @@index([tenantId, nationalIdHash])
  @@map("customers")
}

model CustomerOtpChallenge {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  customerId  String    @map("customer_id") @db.Uuid
  phone       String
  codeHash    String    @map("code_hash")
  expiresAt   DateTime  @map("expires_at")
  consumedAt  DateTime? @map("consumed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  customer    Customer  @relation(fields: [customerId], references: [id])

  @@index([tenantId, phone, createdAt])
  @@map("customer_otp_challenges")
}

model KycCase {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  customerId     String        @map("customer_id") @db.Uuid
  status         KycCaseStatus @default(DRAFT)
  ocrProvider    String?       @map("ocr_provider")
  ocrSummaryJson Json?         @map("ocr_summary_json")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  customer       Customer      @relation(fields: [customerId], references: [id])
  documents      KycDocument[]
  reviewActions  KycReviewAction[]

  @@index([tenantId, customerId])
  @@index([tenantId, status])
  @@map("kyc_cases")
}

model KycDocument {
  id               String          @id @default(uuid()) @db.Uuid
  tenantId         String          @map("tenant_id") @db.Uuid
  kycCaseId        String          @map("kyc_case_id") @db.Uuid
  type             KycDocumentType
  storageKey       String          @map("storage_key")
  mimeType         String          @map("mime_type")
  checksum         String?
  uploadedByUserId String          @map("uploaded_by_user_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at")
  tenant           Tenant          @relation(fields: [tenantId], references: [id])
  kycCase          KycCase         @relation(fields: [kycCaseId], references: [id])
  uploadedBy       User            @relation(fields: [uploadedByUserId], references: [id])

  @@index([tenantId, kycCaseId])
  @@map("kyc_documents")
}

model Consent {
  id         String      @id @default(uuid()) @db.Uuid
  tenantId   String      @map("tenant_id") @db.Uuid
  customerId String      @map("customer_id") @db.Uuid
  type       ConsentType
  version    String
  grantedAt  DateTime    @map("granted_at")
  revokedAt  DateTime?   @map("revoked_at")
  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  customer   Customer    @relation(fields: [customerId], references: [id])

  @@index([tenantId, customerId])
  @@map("consents")
}

model KycReviewAction {
  id         String            @id @default(uuid()) @db.Uuid
  tenantId   String            @map("tenant_id") @db.Uuid
  kycCaseId  String            @map("kyc_case_id") @db.Uuid
  actorUserId String           @map("actor_user_id") @db.Uuid
  decision   KycReviewDecision
  reason     String?
  createdAt  DateTime          @default(now()) @map("created_at")
  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  kycCase    KycCase           @relation(fields: [kycCaseId], references: [id])
  actor      User              @relation(fields: [actorUserId], references: [id])

  @@index([tenantId, kycCaseId])
  @@map("kyc_review_actions")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

model Product {
  id        String        @id @default(uuid()) @db.Uuid
  tenantId  String        @map("tenant_id") @db.Uuid
  name      String
  brand     String
  status    CatalogStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  variants  ProductVariant[]

  @@index([tenantId])
  @@map("products")
}

model ProductVariant {
  id        String        @id @default(uuid()) @db.Uuid
  tenantId  String        @map("tenant_id") @db.Uuid
  productId String        @map("product_id") @db.Uuid
  sku       String
  color     String
  storage   String
  price     Decimal       @db.Decimal(18, 2)
  currency  String        @default("THB") @db.Char(3)
  status    CatalogStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  product   Product       @relation(fields: [productId], references: [id])
  imeiUnits ImeiUnit[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([productId])
  @@map("product_variants")
}

model ImeiUnit {
  id        String         @id @default(uuid()) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  branchId  String         @map("branch_id") @db.Uuid
  variantId String         @map("variant_id") @db.Uuid
  imei      String
  status    ImeiStatus     @default(AVAILABLE)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  branch    Branch         @relation(fields: [branchId], references: [id])
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  movements StockMovement[]
  applications Application[]
  contracts    Contract[]
  devices      Device[]
  deviceContractBindings DeviceContractBinding[]

  @@unique([tenantId, imei])
  @@index([tenantId, branchId])
  @@index([tenantId, status])
  @@map("imei_units")
}

model StockMovement {
  id           String            @id @default(uuid()) @db.Uuid
  tenantId     String            @map("tenant_id") @db.Uuid
  imeiUnitId   String            @map("imei_unit_id") @db.Uuid
  type         StockMovementType
  fromBranchId String?           @map("from_branch_id") @db.Uuid
  toBranchId   String?           @map("to_branch_id") @db.Uuid
  actorUserId  String            @map("actor_user_id") @db.Uuid
  reason       String?
  createdAt    DateTime          @default(now()) @map("created_at")
  tenant       Tenant            @relation(fields: [tenantId], references: [id])
  imeiUnit     ImeiUnit          @relation(fields: [imeiUnitId], references: [id])
  actor        User              @relation(fields: [actorUserId], references: [id])

  @@index([tenantId, imeiUnitId])
  @@index([tenantId, createdAt])
  @@map("stock_movements")
}

model InstallmentPlan {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  code           String
  name           String
  interestMethod InterestMethod @map("interest_method")
  annualRate     Decimal        @map("annual_rate") @db.Decimal(18, 2)
  termMonths     Int            @map("term_months")
  feesJson       Json?          @map("fees_json")
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  applications   Application[]

  @@unique([tenantId, code])
  @@index([tenantId, active])
  @@map("installment_plans")
}

model Application {
  id              String            @id @default(uuid()) @db.Uuid
  tenantId        String            @map("tenant_id") @db.Uuid
  customerId      String            @map("customer_id") @db.Uuid
  imeiUnitId      String            @map("imei_unit_id") @db.Uuid
  planId          String            @map("plan_id") @db.Uuid
  principal       Decimal           @db.Decimal(18, 2)
  downPayment     Decimal           @map("down_payment") @db.Decimal(18, 2)
  termMonths      Int               @map("term_months")
  interestMethod  InterestMethod    @map("interest_method")
  annualRate      Decimal           @map("annual_rate") @db.Decimal(18, 2)
  status          ApplicationStatus @default(DRAFT)
  submittedAt     DateTime?         @map("submitted_at")
  decidedAt       DateTime?         @map("decided_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  tenant          Tenant            @relation(fields: [tenantId], references: [id])
  customer        Customer          @relation(fields: [customerId], references: [id])
  imeiUnit        ImeiUnit          @relation(fields: [imeiUnitId], references: [id])
  plan            InstallmentPlan   @relation(fields: [planId], references: [id])
  scorecard       ScorecardResult?
  approvalActions ApprovalAction[]
  contracts       Contract[]

  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, imeiUnitId])
  @@map("applications")
}

model ScorecardResult {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  applicationId String        @unique @map("application_id") @db.Uuid
  score         Int
  band          ScorecardBand
  reasonsJson   Json          @map("reasons_json")
  version       String
  createdAt     DateTime      @default(now()) @map("created_at")
  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  application   Application   @relation(fields: [applicationId], references: [id])

  @@index([tenantId])
  @@map("scorecard_results")
}

model ApprovalAction {
  id            String              @id @default(uuid()) @db.Uuid
  tenantId      String              @map("tenant_id") @db.Uuid
  applicationId String              @map("application_id") @db.Uuid
  actorUserId   String              @map("actor_user_id") @db.Uuid
  decision      ApplicationDecision
  reason        String?
  createdAt     DateTime            @default(now()) @map("created_at")
  tenant        Tenant              @relation(fields: [tenantId], references: [id])
  application   Application         @relation(fields: [applicationId], references: [id])
  actor         User                @relation(fields: [actorUserId], references: [id])

  @@index([tenantId, applicationId])
  @@map("approval_actions")
}

model Contract {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  applicationId  String         @map("application_id") @db.Uuid
  customerId     String         @map("customer_id") @db.Uuid
  imeiUnitId     String         @map("imei_unit_id") @db.Uuid
  status         ContractStatus @default(DRAFT)
  principal      Decimal        @db.Decimal(18, 2)
  downPayment    Decimal        @map("down_payment") @db.Decimal(18, 2)
  financedAmount Decimal        @map("financed_amount") @db.Decimal(18, 2)
  termMonths     Int            @map("term_months")
  interestMethod InterestMethod @map("interest_method")
  annualRate     Decimal        @map("annual_rate") @db.Decimal(18, 2)
  currency       String         @default("THB") @db.Char(3)
  activatedAt    DateTime?      @map("activated_at")
  cancelledAt    DateTime?      @map("cancelled_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  application    Application    @relation(fields: [applicationId], references: [id])
  customer       Customer       @relation(fields: [customerId], references: [id])
  imeiUnit       ImeiUnit       @relation(fields: [imeiUnitId], references: [id])
  versions       ContractVersion[]
  scheduleItems  PaymentScheduleItem[]
  paymentIntents PaymentIntent[]
  enrollmentSessions DeviceEnrollmentSession[]
  deviceActivations DeviceActivation[]
  deviceContractBindings DeviceContractBinding[]

  @@index([tenantId, status])
  @@index([tenantId, applicationId])
  @@map("contracts")
}

model ContractVersion {
  id            String     @id @default(uuid()) @db.Uuid
  tenantId      String     @map("tenant_id") @db.Uuid
  contractId    String     @map("contract_id") @db.Uuid
  version       Int
  termsJson     Json       @map("terms_json")
  scheduleHash  String     @map("schedule_hash")
  createdAt     DateTime   @default(now()) @map("created_at")
  tenant        Tenant     @relation(fields: [tenantId], references: [id])
  contract      Contract   @relation(fields: [contractId], references: [id])
  scheduleItems PaymentScheduleItem[]

  @@unique([contractId, version])
  @@index([tenantId])
  @@map("contract_versions")
}

model PaymentScheduleItem {
  id                String             @id @default(uuid()) @db.Uuid
  tenantId          String             @map("tenant_id") @db.Uuid
  contractId        String             @map("contract_id") @db.Uuid
  contractVersionId String             @map("contract_version_id") @db.Uuid
  seq               Int
  dueDate           DateTime           @map("due_date") @db.Date
  principalDue      Decimal            @map("principal_due") @db.Decimal(18, 2)
  interestDue       Decimal            @map("interest_due") @db.Decimal(18, 2)
  feesDue           Decimal            @map("fees_due") @db.Decimal(18, 2)
  totalDue          Decimal            @map("total_due") @db.Decimal(18, 2)
  amountPaid        Decimal            @default(0) @map("amount_paid") @db.Decimal(18, 2)
  status            ScheduleItemStatus @default(PENDING)
  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  contract          Contract           @relation(fields: [contractId], references: [id])
  contractVersion   ContractVersion    @relation(fields: [contractVersionId], references: [id])
  allocations       Allocation[]

  @@unique([contractVersionId, seq])
  @@index([tenantId, contractId])
  @@map("payment_schedule_items")
}

model PaymentIntent {
  id              String              @id @default(uuid()) @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  contractId      String              @map("contract_id") @db.Uuid
  amount          Decimal             @db.Decimal(18, 2)
  currency        String              @default("THB") @db.Char(3)
  idempotencyKey  String              @map("idempotency_key")
  status          PaymentIntentStatus @default(CREATED)
  provider        String
  providerRef     String?             @map("provider_ref")
  qrPayloadJson        Json?               @map("qr_payload_json")
  createdByUserId      String?             @map("created_by_user_id") @db.Uuid
  createdByCustomerId  String?             @map("created_by_customer_id") @db.Uuid
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  tenant               Tenant              @relation(fields: [tenantId], references: [id])
  contract             Contract            @relation(fields: [contractId], references: [id])
  createdBy            User?               @relation(fields: [createdByUserId], references: [id])
  createdByCustomer    Customer?           @relation(fields: [createdByCustomerId], references: [id])
  transaction          PaymentTransaction?

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, contractId])
  @@map("payment_intents")
}

model PaymentTransaction {
  id              String                   @id @default(uuid()) @db.Uuid
  tenantId        String                   @map("tenant_id") @db.Uuid
  paymentIntentId String                   @unique @map("payment_intent_id") @db.Uuid
  providerEventId String                   @unique @map("provider_event_id")
  amount          Decimal                  @db.Decimal(18, 2)
  status          PaymentTransactionStatus
  rawEventJson    Json                     @map("raw_event_json")
  verifiedAt      DateTime                 @map("verified_at")
  createdAt       DateTime                 @default(now()) @map("created_at")
  tenant          Tenant                   @relation(fields: [tenantId], references: [id])
  paymentIntent   PaymentIntent            @relation(fields: [paymentIntentId], references: [id])
  allocations     Allocation[]
  ledgerEntries   LedgerEntry[]

  @@index([tenantId])
  @@map("payment_transactions")
}

model Allocation {
  id                   String             @id @default(uuid()) @db.Uuid
  tenantId             String             @map("tenant_id") @db.Uuid
  paymentTransactionId String             @map("payment_transaction_id") @db.Uuid
  scheduleItemId       String             @map("schedule_item_id") @db.Uuid
  amount               Decimal            @db.Decimal(18, 2)
  createdAt            DateTime           @default(now()) @map("created_at")
  tenant               Tenant             @relation(fields: [tenantId], references: [id])
  paymentTransaction   PaymentTransaction @relation(fields: [paymentTransactionId], references: [id])
  scheduleItem         PaymentScheduleItem @relation(fields: [scheduleItemId], references: [id])

  @@unique([paymentTransactionId, scheduleItemId])
  @@index([tenantId, scheduleItemId])
  @@map("allocations")
}

model LedgerEntry {
  id                   String             @id @default(uuid()) @db.Uuid
  tenantId             String             @map("tenant_id") @db.Uuid
  paymentTransactionId String             @map("payment_transaction_id") @db.Uuid
  domain               LedgerDomain
  direction            LedgerDirection
  accountCode          String             @map("account_code")
  amount               Decimal            @db.Decimal(18, 2)
  createdAt            DateTime           @default(now()) @map("created_at")
  tenant               Tenant             @relation(fields: [tenantId], references: [id])
  paymentTransaction   PaymentTransaction @relation(fields: [paymentTransactionId], references: [id])

  @@index([tenantId, paymentTransactionId])
  @@map("ledger_entries")
}

model DeviceEnrollmentSession {
  id              String                   @id @default(uuid()) @db.Uuid
  tenantId        String                   @map("tenant_id") @db.Uuid
  contractId      String                   @map("contract_id") @db.Uuid
  imeiUnitId      String                   @map("imei_unit_id") @db.Uuid
  platform        DevicePlatform
  status          EnrollmentSessionStatus  @default(WAITING_FOR_DEVICE)
  tokenHash       String                   @unique @map("token_hash")
  idempotencyKey  String                   @map("idempotency_key")
  expiresAt       DateTime                 @map("expires_at")
  qrFingerprint   String?                  @map("qr_fingerprint")
  createdByUserId String                   @map("created_by_user_id") @db.Uuid
  lastErrorCode   String?                  @map("last_error_code")
  deviceId        String?                  @unique @map("device_id") @db.Uuid
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")
  tenant          Tenant                   @relation(fields: [tenantId], references: [id])
  contract        Contract                 @relation(fields: [contractId], references: [id])
  createdBy       User                     @relation(fields: [createdByUserId], references: [id])
  device          Device?                  @relation(fields: [deviceId], references: [id])
  activation      DeviceActivation?

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, contractId, status])
  @@index([tenantId, status, expiresAt])
  @@map("device_enrollment_sessions")
}

model Device {
  id                   String                @id @default(uuid()) @db.Uuid
  tenantId             String                @map("tenant_id") @db.Uuid
  imeiUnitId           String                @map("imei_unit_id") @db.Uuid
  platform             DevicePlatform
  status               DeviceLifecycleStatus @default(PENDING_ENROLL)
  hardwareFingerprint  String                @map("hardware_fingerprint")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  tenant               Tenant                @relation(fields: [tenantId], references: [id])
  imeiUnit             ImeiUnit              @relation(fields: [imeiUnitId], references: [id])
  enrollmentSession    DeviceEnrollmentSession?
  activation           DeviceActivation?
  bindings             DeviceContractBinding[]
  auditEvents          DeviceAuditEvent[]

  @@unique([tenantId, hardwareFingerprint])
  @@unique([tenantId, imeiUnitId])
  @@index([tenantId, status])
  @@map("devices")
}

model DeviceActivation {
  id                   String                   @id @default(uuid()) @db.Uuid
  tenantId             String                   @map("tenant_id") @db.Uuid
  deviceId             String                   @unique @map("device_id") @db.Uuid
  enrollmentSessionId  String                   @unique @map("enrollment_session_id") @db.Uuid
  customerId           String                   @map("customer_id") @db.Uuid
  contractId           String                   @map("contract_id") @db.Uuid
  actorUserId          String                   @map("actor_user_id") @db.Uuid
  reason               String
  shopCode             String?                  @map("shop_code")
  idempotencyKey       String                   @map("idempotency_key")
  createdAt            DateTime                 @default(now()) @map("created_at")
  tenant               Tenant                   @relation(fields: [tenantId], references: [id])
  device               Device                   @relation(fields: [deviceId], references: [id])
  enrollmentSession    DeviceEnrollmentSession  @relation(fields: [enrollmentSessionId], references: [id])
  customer             Customer                 @relation(fields: [customerId], references: [id])
  contract             Contract                 @relation(fields: [contractId], references: [id])
  actor                User                     @relation(fields: [actorUserId], references: [id])

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, contractId])
  @@map("device_activations")
}

model DeviceContractBinding {
  id                    String              @id @default(uuid()) @db.Uuid
  tenantId              String              @map("tenant_id") @db.Uuid
  deviceId              String              @map("device_id") @db.Uuid
  contractId            String              @map("contract_id") @db.Uuid
  imeiUnitId            String              @map("imei_unit_id") @db.Uuid
  status                DeviceBindingStatus @default(ACTIVE)
  reason                String
  actorUserId           String              @map("actor_user_id") @db.Uuid
  bindIdempotencyKey    String              @map("bind_idempotency_key")
  unbindReason          String?             @map("unbind_reason")
  unbindActorUserId     String?             @map("unbind_actor_user_id") @db.Uuid
  unbindIdempotencyKey  String?             @map("unbind_idempotency_key")
  boundAt               DateTime            @default(now()) @map("bound_at")
  unboundAt             DateTime?           @map("unbound_at")
  tenant                Tenant              @relation(fields: [tenantId], references: [id])
  device                Device              @relation(fields: [deviceId], references: [id])
  contract              Contract            @relation(fields: [contractId], references: [id])
  imeiUnit              ImeiUnit            @relation(fields: [imeiUnitId], references: [id])
  actor                 User                @relation(fields: [actorUserId], references: [id])

  @@unique([tenantId, bindIdempotencyKey])
  @@index([tenantId, deviceId, status])
  @@index([tenantId, contractId, status])
  @@index([tenantId, imeiUnitId, status])
  @@map("device_contract_bindings")
}

model DeviceAuditEvent {
  id          String            @id @default(uuid()) @db.Uuid
  tenantId    String            @map("tenant_id") @db.Uuid
  deviceId    String            @map("device_id") @db.Uuid
  actorUserId String            @map("actor_user_id") @db.Uuid
  action      DeviceAuditAction
  reason      String
  createdAt   DateTime          @default(now()) @map("created_at")
  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  device      Device            @relation(fields: [deviceId], references: [id])
  actor       User              @relation(fields: [actorUserId], references: [id])

  @@index([tenantId, deviceId, createdAt])
  @@map("device_audit_events")
}
