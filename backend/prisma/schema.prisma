generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum PlatformRole {
  SUPER_ADMIN
  MERCHANT_OWNER
  MERCHANT_STAFF
}

enum CatalogStatus {
  ACTIVE
  INACTIVE
}

enum ImeiStatus {
  AVAILABLE
  RESERVED
  SOLD
  TRANSFERRED_OUT
}

enum StockMovementType {
  RECEIVE
  TRANSFER
  RESERVE
  RELEASE
  SELL
  ADJUST
}

enum CustomerStatus {
  ACTIVE
  DISABLED
}

enum KycCaseStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
  NEEDS_RESUBMIT
}

enum KycDocumentType {
  ID_FRONT
  ID_BACK
  SELFIE
  OTHER
}

enum ConsentType {
  PDPA_PROCESSING
  MARKETING
}

enum KycReviewDecision {
  APPROVE
  REJECT
  REQUEST_RESUBMIT
}

enum InterestMethod {
  FLAT
  REDUCING
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

enum ScorecardBand {
  LOW
  MEDIUM
  HIGH
}

enum ApplicationDecision {
  APPROVE
  REJECT
}

model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  status    TenantStatus @default(PENDING)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  branches  Branch[]
  users     User[]
  products  Product[]
  variants  ProductVariant[]
  imeiUnits ImeiUnit[]
  stockMovements StockMovement[]
  customers       Customer[]
  kycCases        KycCase[]
  kycDocuments    KycDocument[]
  consents        Consent[]
  kycReviewActions KycReviewAction[]
  installmentPlans InstallmentPlan[]
  applications     Application[]
  scorecardResults ScorecardResult[]
  approvalActions  ApprovalAction[]

  @@map("tenants")
}

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  imeiUnits ImeiUnit[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("branches")
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String?        @map("tenant_id") @db.Uuid
  email         String         @unique
  passwordHash  String         @map("password_hash")
  fullName      String         @map("full_name")
  role          PlatformRole   @default(MERCHANT_STAFF)
  status        UserStatus     @default(ACTIVE)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  tenant        Tenant?        @relation(fields: [tenantId], references: [id])
  refreshTokens RefreshToken[]
  stockMovements StockMovement[]
  kycDocumentsUploaded KycDocument[]
  kycReviewActions     KycReviewAction[]
  approvalActions      ApprovalAction[]

  @@index([tenantId])
  @@map("users")
}

model Customer {
  id                  String         @id @default(uuid()) @db.Uuid
  tenantId            String         @map("tenant_id") @db.Uuid
  fullName            String         @map("full_name")
  phone               String
  nationalIdEncrypted String         @map("national_id_encrypted")
  nationalIdHash      String         @map("national_id_hash")
  nationalIdLast4     String         @map("national_id_last4")
  status              CustomerStatus @default(ACTIVE)
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")
  tenant              Tenant         @relation(fields: [tenantId], references: [id])
  kycCases            KycCase[]
  consents            Consent[]
  applications        Application[]

  @@unique([tenantId, phone])
  @@index([tenantId, nationalIdHash])
  @@map("customers")
}

model KycCase {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  customerId     String        @map("customer_id") @db.Uuid
  status         KycCaseStatus @default(DRAFT)
  ocrProvider    String?       @map("ocr_provider")
  ocrSummaryJson Json?         @map("ocr_summary_json")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  customer       Customer      @relation(fields: [customerId], references: [id])
  documents      KycDocument[]
  reviewActions  KycReviewAction[]

  @@index([tenantId, customerId])
  @@index([tenantId, status])
  @@map("kyc_cases")
}

model KycDocument {
  id               String          @id @default(uuid()) @db.Uuid
  tenantId         String          @map("tenant_id") @db.Uuid
  kycCaseId        String          @map("kyc_case_id") @db.Uuid
  type             KycDocumentType
  storageKey       String          @map("storage_key")
  mimeType         String          @map("mime_type")
  checksum         String?
  uploadedByUserId String          @map("uploaded_by_user_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at")
  tenant           Tenant          @relation(fields: [tenantId], references: [id])
  kycCase          KycCase         @relation(fields: [kycCaseId], references: [id])
  uploadedBy       User            @relation(fields: [uploadedByUserId], references: [id])

  @@index([tenantId, kycCaseId])
  @@map("kyc_documents")
}

model Consent {
  id         String      @id @default(uuid()) @db.Uuid
  tenantId   String      @map("tenant_id") @db.Uuid
  customerId String      @map("customer_id") @db.Uuid
  type       ConsentType
  version    String
  grantedAt  DateTime    @map("granted_at")
  revokedAt  DateTime?   @map("revoked_at")
  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  customer   Customer    @relation(fields: [customerId], references: [id])

  @@index([tenantId, customerId])
  @@map("consents")
}

model KycReviewAction {
  id         String            @id @default(uuid()) @db.Uuid
  tenantId   String            @map("tenant_id") @db.Uuid
  kycCaseId  String            @map("kyc_case_id") @db.Uuid
  actorUserId String           @map("actor_user_id") @db.Uuid
  decision   KycReviewDecision
  reason     String?
  createdAt  DateTime          @default(now()) @map("created_at")
  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  kycCase    KycCase           @relation(fields: [kycCaseId], references: [id])
  actor      User              @relation(fields: [actorUserId], references: [id])

  @@index([tenantId, kycCaseId])
  @@map("kyc_review_actions")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

model Product {
  id        String        @id @default(uuid()) @db.Uuid
  tenantId  String        @map("tenant_id") @db.Uuid
  name      String
  brand     String
  status    CatalogStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  variants  ProductVariant[]

  @@index([tenantId])
  @@map("products")
}

model ProductVariant {
  id        String        @id @default(uuid()) @db.Uuid
  tenantId  String        @map("tenant_id") @db.Uuid
  productId String        @map("product_id") @db.Uuid
  sku       String
  color     String
  storage   String
  price     Decimal       @db.Decimal(18, 2)
  currency  String        @default("THB") @db.Char(3)
  status    CatalogStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  product   Product       @relation(fields: [productId], references: [id])
  imeiUnits ImeiUnit[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([productId])
  @@map("product_variants")
}

model ImeiUnit {
  id        String         @id @default(uuid()) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  branchId  String         @map("branch_id") @db.Uuid
  variantId String         @map("variant_id") @db.Uuid
  imei      String
  status    ImeiStatus     @default(AVAILABLE)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  branch    Branch         @relation(fields: [branchId], references: [id])
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  movements StockMovement[]
  applications Application[]

  @@unique([tenantId, imei])
  @@index([tenantId, branchId])
  @@index([tenantId, status])
  @@map("imei_units")
}

model StockMovement {
  id           String            @id @default(uuid()) @db.Uuid
  tenantId     String            @map("tenant_id") @db.Uuid
  imeiUnitId   String            @map("imei_unit_id") @db.Uuid
  type         StockMovementType
  fromBranchId String?           @map("from_branch_id") @db.Uuid
  toBranchId   String?           @map("to_branch_id") @db.Uuid
  actorUserId  String            @map("actor_user_id") @db.Uuid
  reason       String?
  createdAt    DateTime          @default(now()) @map("created_at")
  tenant       Tenant            @relation(fields: [tenantId], references: [id])
  imeiUnit     ImeiUnit          @relation(fields: [imeiUnitId], references: [id])
  actor        User              @relation(fields: [actorUserId], references: [id])

  @@index([tenantId, imeiUnitId])
  @@index([tenantId, createdAt])
  @@map("stock_movements")
}

model InstallmentPlan {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  code           String
  name           String
  interestMethod InterestMethod @map("interest_method")
  annualRate     Decimal        @map("annual_rate") @db.Decimal(18, 2)
  termMonths     Int            @map("term_months")
  feesJson       Json?          @map("fees_json")
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  applications   Application[]

  @@unique([tenantId, code])
  @@index([tenantId, active])
  @@map("installment_plans")
}

model Application {
  id              String            @id @default(uuid()) @db.Uuid
  tenantId        String            @map("tenant_id") @db.Uuid
  customerId      String            @map("customer_id") @db.Uuid
  imeiUnitId      String            @map("imei_unit_id") @db.Uuid
  planId          String            @map("plan_id") @db.Uuid
  principal       Decimal           @db.Decimal(18, 2)
  downPayment     Decimal           @map("down_payment") @db.Decimal(18, 2)
  termMonths      Int               @map("term_months")
  interestMethod  InterestMethod    @map("interest_method")
  annualRate      Decimal           @map("annual_rate") @db.Decimal(18, 2)
  status          ApplicationStatus @default(DRAFT)
  submittedAt     DateTime?         @map("submitted_at")
  decidedAt       DateTime?         @map("decided_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  tenant          Tenant            @relation(fields: [tenantId], references: [id])
  customer        Customer          @relation(fields: [customerId], references: [id])
  imeiUnit        ImeiUnit          @relation(fields: [imeiUnitId], references: [id])
  plan            InstallmentPlan   @relation(fields: [planId], references: [id])
  scorecard       ScorecardResult?
  approvalActions ApprovalAction[]

  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, imeiUnitId])
  @@map("applications")
}

model ScorecardResult {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  applicationId String        @unique @map("application_id") @db.Uuid
  score         Int
  band          ScorecardBand
  reasonsJson   Json          @map("reasons_json")
  version       String
  createdAt     DateTime      @default(now()) @map("created_at")
  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  application   Application   @relation(fields: [applicationId], references: [id])

  @@index([tenantId])
  @@map("scorecard_results")
}

model ApprovalAction {
  id            String              @id @default(uuid()) @db.Uuid
  tenantId      String              @map("tenant_id") @db.Uuid
  applicationId String              @map("application_id") @db.Uuid
  actorUserId   String              @map("actor_user_id") @db.Uuid
  decision      ApplicationDecision
  reason        String?
  createdAt     DateTime            @default(now()) @map("created_at")
  tenant        Tenant              @relation(fields: [tenantId], references: [id])
  application   Application         @relation(fields: [applicationId], references: [id])
  actor         User                @relation(fields: [actorUserId], references: [id])

  @@index([tenantId, applicationId])
  @@map("approval_actions")
}
